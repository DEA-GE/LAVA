from pathlib import Path
import sys
import json
import yaml

PROJECT_ROOT = Path.cwd()
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from utils.tech_config import (
    resolve_selected_scenarios,
    validate_selected_scenarios,
    validate_shared_scenarios,
)
from utils.region_names import canonical_region_name



with open("configs/config_snakemake.yaml", "r", encoding="utf-8") as f:
    config_snakemake = yaml.load(f, Loader=yaml.FullLoader)


#define parameters , keep them in list as it iterates, multiple input can be included. 
configured_regions = config_snakemake["study_region_name"]
if isinstance(configured_regions, str):
    configured_regions = [configured_regions]
region_names = {
    canonical_region_name(region): region
    for region in configured_regions
}
if len(region_names) != len(configured_regions):
    raise ValueError("Study region names must remain unique after filename cleaning.")
regions = list(region_names)
technologies = config_snakemake["technologies"]
scenarios = config_snakemake.get("scenarios", [])
technology_scenarios = config_snakemake.get("technology_scenarios", {})
weather_years = config_snakemake["weather_years"]


def get_scenarios_for_technology(technology):
    return resolve_selected_scenarios(
        technology,
        scenarios,
        technology_scenarios,
    )


def configured_region_name(cleaned_region):
    return region_names[cleaned_region]


def exclusion_result_targets():
    """Return the exact exclusion rasters required by downstream result stages."""
    targets = []
    for technology in technologies:
        targets += expand(
            Path("data")
            / "{region}"
            / "available_land"
            / "{region}_{technology}_{scenario}_available_land.tif",
            region=regions,
            technology=[technology],
            scenario=get_scenarios_for_technology(technology),
        )
    return targets


def exclusion_metadata_targets():
    """Return the exclusion JSON metrics consumed by results analysis."""
    targets = []
    for technology in technologies:
        targets += expand(
            Path("data")
            / "{region}"
            / "available_land"
            / "{region}_{technology}_{scenario}_exclusion_info.json",
            region=regions,
            technology=[technology],
            scenario=get_scenarios_for_technology(technology),
        )
    return targets


validate_selected_scenarios(
    technologies,
    scenarios,
    technology_scenarios=technology_scenarios,
)

def logpath(region, filename):
    return Path("data") / region / "snakemake_log" / filename

# Create directories for each region and snakemake log
for r in regions:
    Path(f"data/{r}/snakemake_log").mkdir(parents=True, exist_ok=True)

"""script to run in terminal
The snakemake workflow will parallelize (--cores > 1) everything else but the spatial_data_prep script. 
The resources are limited to openeo cause the api is throwing problems with parallelization. 
    use thi line ---->  snakemake --cores 4 --resources openeo_req=1
to use a specific Snakefile, use the --snakefile option
    use this line ----> snakemake --snakefile snakemake/Snakefile_short_short --cores 4 --resources openeo_req=1
"""
# ---- Stage configuration ----
stages = config_snakemake.get("stages", {})

if stages.get("suitability"):
    validate_shared_scenarios(
        technologies,
        scenarios,
        technology_scenarios=technology_scenarios,
    )

# ---- Create the global functions ----
globals().update({
    f"DO_{k.upper()}": v
    for k, v in stages.items()
})


# ---- Compact includes ----
# Exclusion uses spatial_data_prep as a checkpoint. Including the checkpoint
# does not run it when its CRS output is present and up to date.
included_stages = {name for name, enabled in stages.items() if enabled}
if stages.get("exclusion") or stages.get("suitability") or stages.get("results_analysis"):
    included_stages.add("exclusion")
    included_stages.add("spatial_data_prep")

for stage_name in stages:
    if stage_name in included_stages:
        include: f"rules/{stage_name}.smk"


# ---- Build 'all' targets (explicit form for clarity) ----
ALL_TARGETS = []

if stages.get("spatial_data_prep"):
    ALL_TARGETS += expand(
        Path("data") / "{region}" / "{region}_local_CRS.pkl",
        region=regions,
    )

if stages.get("exclusion"):
    ALL_TARGETS += exclusion_result_targets()

if stages.get("suitability"):
    suitability_scenarios = list(
        dict.fromkeys(
            [scenario for technology in technologies for scenario in get_scenarios_for_technology(technology)]
        )
    )
    ALL_TARGETS += expand(
        logpath("{region}", "suitability_{scenario}.done"),
        region=regions,
        scenario=suitability_scenarios,
    )

if stages.get("timeseries"):
    for technology in technologies:
        tech_scenarios = get_scenarios_for_technology(technology)
        ALL_TARGETS += expand(
            logpath("{region}", "timeseries_{technology}_{weather_year}_{scenario}.done"),
            region=regions,
            technology=[technology],
            weather_year=weather_years,
            scenario=tech_scenarios,
        )


if stages.get("weather_data_prep"):
    ALL_TARGETS += expand(
        logpath("{region}", "weather_data_prep_{weather_year}.done"),
        region=regions,
        weather_year=weather_years,
    )

if stages.get("weather_bias_adjust"):
    ALL_TARGETS += expand(
        logpath("{region}", "weather_bias_adjust.done"),
        region=regions,
    )

if stages.get("energy_profiles"):
    for technology in technologies:
        tech_scenarios = get_scenarios_for_technology(technology)
        ALL_TARGETS += expand(
            logpath("{region}", "energy_profiles_{technology}_{weather_year}_{scenario}.done"),
            region=regions,
            scenario=tech_scenarios,
            technology=[technology],
            weather_year=weather_years,
        )

if stages.get("results_analysis"):
    ALL_TARGETS += [
        Path("aggregated_available_land.gpkg"),
        Path("aggregated_available_land.json"),
        Path("aggregated_available_land.csv"),
    ]

rule all:
    input:
        ALL_TARGETS
